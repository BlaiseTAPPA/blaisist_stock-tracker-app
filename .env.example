# FinGenius environment variables.
# Copy this file to `.env.local` and fill in the values. Never commit `.env.local`.
# In Vercel, set the same variables under Settings → Environment Variables.

# --- App -------------------------------------------------------------------

# Public URL of the app, without a trailing slash (http://localhost:3000 locally).
# Used for metadata (`metadataBase`) and for the links in emails.
NEXT_PUBLIC_BASE_URL=

# --- Database --------------------------------------------------------------

# MongoDB connection string, including the database name
# (e.g. mongodb+srv://user:password@cluster.example.mongodb.net/fingenius).
# Check it with `npm run test:db`.
MONGODB_URI=

# --- Authentication (Better Auth) ------------------------------------------

# Random secret of at least 32 characters, used to sign sessions.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Base URL Better Auth runs on: same value as NEXT_PUBLIC_BASE_URL.
BETTER_AUTH_URL=

# --- Market data (Finnhub) -------------------------------------------------

# API key from https://finnhub.io/dashboard (the free tier is enough). Server-only.
FINNHUB_API_KEY=

# Optional. Finnhub API base URL; defaults to https://finnhub.io/api/v1.
# Only the end-to-end tests change it, to point at their local mock.
# FINNHUB_BASE_URL=

# --- AI (Google Gemini, called from Inngest jobs) --------------------------

# API key from https://aistudio.google.com/app/apikey. Writes the welcome
# message and the daily news summary.
GEMINI_API_KEY=

# --- Email (Nodemailer over Gmail) -----------------------------------------

# Gmail address the emails are sent from.
NODEMAILER_EMAIL=

# Gmail app password (16 characters, Google Account → Security → App passwords;
# requires 2-step verification). Not the account password.
NODEMAILER_PASSWORD=

# --- Background jobs (Inngest) ---------------------------------------------

# Production only: keys from the Inngest dashboard (or set by the Inngest
# Vercel integration). Leave empty locally.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Local only: set to 1 to use the Inngest dev server (`npx inngest-cli dev`).
# Never define it in Vercel Production: it disables signature verification.
# Left commented out: some tools treat an empty value differently from an unset one.
# INNGEST_DEV=1

# --- Debugging (optional) --------------------------------------------------

# Set to 1 to log every real HTTP request sent to Finnhub (cache hits excluded).
# FINNHUB_DEBUG=1
